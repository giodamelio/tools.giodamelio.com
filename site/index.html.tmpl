<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Some Random Tools by Giovanni d'Amelio</title>
    <meta
      name="description"
      content="A collection of small, single-purpose web tools."
    />
    <link rel="stylesheet" href="base.css" />
    <link rel="stylesheet" href="site.css" />
    <link rel="alternate" type="text/markdown" href="index.md" />
  </head>
  <body>
    <main>
      <header>
        <h1>Some Random Tools by Giovanni d'Amelio</h1>
        <p>A collection of small, single-purpose web tools.</p>
      </header>

      <ul class="tools">
{{- range .tools }}
        <li>
          <a href="{{ .mount }}">
            <span class="name">{{ .name | html }}</span>
            <span class="desc">{{ .description | html }}</span>
          </a>
        </li>
{{- end }}
      </ul>

      <footer>
        <p>
          Built by <a href="https://giodamelio.com">Giovanni d'Amelio</a> &middot;
          <a href="https://github.com/giodamelio/tools.giodamelio.com">Source</a>
          &middot; Inspired by
          <a href="https://tools.simonwillison.net/">tools.simonwillison.net</a>
        </p>
      </footer>
    </main>
  </body>
</html>
