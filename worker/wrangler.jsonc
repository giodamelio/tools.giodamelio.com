// Paths here are relative to this file. The assets directory is not one of
// them: it is a build output, so the scripts in nix/apps.nix pass the built
// site as --assets rather than pinning a path that would go stale. The
// `tool-routes.js` that index.js imports is generated too, and the devShell
// links it in beside this file.
{
	"name": "tools-giodamelio-com",
	"main": "index.js",
	"compatibility_date": "2026-05-14",
	"assets": {
		"binding": "ASSETS"
	},
	"routes": [
		{
			"pattern": "tools.giodamelio.com",
			"custom_domain": true
		}
	],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "keeper-of-state",
			"database_id": "d5a4697d-213a-4f77-a305-cb72fa3700ba",
			"migrations_dir": "migrations"
		}
	],
	"rules": [
		{
			"type": "Text",
			"globs": [
				"**/*.yaml",
				"**/*.md"
			],
			"fallthrough": true
		}
	],
	"ratelimits": [
		{
			"name": "KEEPER_CREATE",
			"namespace_id": "1001",
			"simple": {
				"limit": 20,
				"period": 60
			}
		}
	]
}
