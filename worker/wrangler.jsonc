// Paths here are relative to the assembled worker root that nix/worker.nix
// builds, not to this file's place in the repo.
{
	"name": "tools-giodamelio-com",
	"main": "index.js",
	"compatibility_date": "2026-05-14",
	"assets": {
		"directory": "./public",
		"binding": "ASSETS"
	},
	"routes": [
		{
			"pattern": "tools.giodamelio.com",
			"custom_domain": true
		}
	],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "keeper-of-state",
			"database_id": "d5a4697d-213a-4f77-a305-cb72fa3700ba",
			"migrations_dir": "migrations"
		}
	],
	"rules": [
		{
			"type": "Text",
			"globs": [
				"**/*.yaml",
				"**/*.md"
			],
			"fallthrough": true
		}
	],
	"ratelimits": [
		{
			"name": "KEEPER_CREATE",
			"namespace_id": "1001",
			"simple": {
				"limit": 20,
				"period": 60
			}
		}
	]
}
