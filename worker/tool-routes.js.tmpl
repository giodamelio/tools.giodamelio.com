// GENERATED by nix/worker.nix from each tool's passthru.tool.routes and passthru.tool.preview.
// Edit the tool's package.nix, not this file.
//
// A route with `page` serves that page, adding the og:* tags from the `preview` binding when it names one.
// A route with `service` is answered by that binding.
export const TOOL_ROUTES = [
{{- range .routes }}
  {...{{ . | data.ToJSON }}, pattern: new RegExp({{ .pattern | data.ToJSON }})},
{{- end }}
];
